  "canonical_corpus": {
    "format": "Markdown",
    "principles": [
      "Convert other source formats to UTF-8 Markdown with stable work, edition, passage and page or folio locators when available.",
      "Preserve original wording, scripts, accents, variants, attribution and source alignment; mark uncertain OCR and missing material.",
      "Keep machine-readable metadata and provenance alongside Markdown, including source URL, edition, rights, hash, conversion method, version, review status and locator mappings.",
      "Retain authorized original source artifacts separately as evidence; the AI corpus uses Markdown. Do not assume conversion resolves reuse rights.",
      "Split for retrieval at meaningful passage boundaries with context; never equate Markdown conversion with transcription accuracy."
    ],
    "search_note": "Keyword, semantic retrieval and summarization are future capabilities, not implemented by this catalogue."
  },
  "facet_policy": {
    "multi_valued": "A work may belong to multiple traditions, collections, languages and topics; unknown is not none.",
    "source_labels": "Retain source labels and map them to normalized facets only with evidence and review.",
    "topic_tags": "Proposed discovery vocabulary; assignments are not authoritative without textual evidence.",
    "language_script": "Language, script and transliteration scheme are separate; record source-specific values per edition.",
    "search": "Index original and normalized titles, aliases, scripts and transliterations separately. Future semantic search must retrieve source-backed passages, with edition, access and provenance filters.",
    "relations": "Explicitly evidence commentary, translation and parallel links; do not infer identity from names or numbering.",
    "migration": "Version 2 moves works[].editions to top-level editions[], linked by work_id; IDs and edition evidence are retained.",
    "filtering": "Use contains for multi-value facets; an exact is filter may not match array values."
